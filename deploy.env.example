# Üretim / sunucu ortamı için gerekli environment variable'lar (örnek değerler, gerçek değer yazmayın).
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=db.example;Port=5432;Database=akna_transport;Username=akna;Password=CHANGE_ME
Jwt__Secret=CHANGE_ME_EN_AZ_32_KARAKTER_RASTGELE_DEGER
Jwt__Issuer=AknaTransport
Jwt__Audience=AknaTransport.Mobile
Seed__AdminEmail=admin@akna.com.tr
Seed__AdminPassword=CHANGE_ME
# E-posta: Gmail için Provider=Smtp, Host=smtp.gmail.com, Port=587, Security=StartTls,
# Username/FromEmail = Gmail adresi, Password = Google "uygulama şifresi" (normal hesap şifresi değil).
# Resend için Email__Provider=Resend + Email__ResendApiKey.
Email__Provider=Smtp
Email__ResendApiKey=
Email__Host=smtp.gmail.com
Email__Port=587
Email__Security=StartTls
Email__Username=
Email__Password=
Email__FromEmail=
# Her e-postaya CC (';' ile birden fazla)
Email__AlwaysCc=imertakpinar0@gmail.com
Sms__Provider=
Sms__ApiUrl=
Sms__Username=
Sms__Password=
Sms__Sender=
# Telefon bildirimleri (Expo Push). Expo'da "Enhanced push security" açıksa erişim anahtarı gerekir.
Push__Enabled=true
Push__ExpoAccessToken=
# GİB e-Arşiv portalı: EArchive__Provider=GibPortal + portal kullanıcı kodu/şifresi
EArchive__Provider=
EArchive__Username=
EArchive__Password=
EArchive__UseTestEnvironment=false
# Özel entegratör kullanılırsa
EArchive__ApiUrl=
EArchive__ApiKey=
# Faturada yazılacak IBAN ve banka; varsayılan tevkifat kodu (ör. 624)
App__CompanyIban=
App__CompanyBankName=
App__DefaultWithholdingCode=
App__PasswordResetUrl=aknatransport://reset-password?token={token}&email={email}
# Müşteri canlı takip bağlantısı. Boş bırakılırsa API'nin kendi sayfası kullanılır: https://<api>/takip/?t=<token>
App__TrackingUrl=
Cors__AllowedOrigins__0=https://panel.akna.com.tr
Database__ApplyMigrationsOnStartup=false
Swagger__Enabled=false
# GİB e-Arşiv faturasını PDF'e çevirmek için Chrome/Chromium/Edge. Boşsa bilinen yerler denenir (Windows'ta Edge otomatik bulunur).
# Linux: sudo apt install chromium  (veya: npx @puppeteer/browsers install chrome-headless-shell@stable)
Pdf__ChromePath=
